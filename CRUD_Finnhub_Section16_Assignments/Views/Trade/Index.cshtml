@model ViewModels.StockTrade
@inject IConfiguration Configuration



<div class="box container">

	<div class="box">
		<h2 id="stockName">@Model.StockName (@Model.StockSymbol)</h2>
		<p id="stockPrice">$ @Model.Price</p>

	</div>

	<input type="hidden" id="stockSymbol" value="@Model.StockSymbol" />

	<div class="box">
		<h2>Buy Order</h2>
		<form class="form-card" asp-controller="Trade" asp-action="BuyOrder" method="post">
			<input type="hidden" name="StockSymbol" value="@Model.StockSymbol" />
			<input type="hidden" name="StockName" value="@Model.StockName" />
			<input type="hidden" name="Price" value="@Model.Price" />
			<input type="number" name="Quantity" value="@Model.Quantity" />

			<button type="submit" class="btn btn-primary btn-success">Buy</button>

		</form>

	</div>


	<div class="box">
		<h2>Sell Order</h2>
		<form class="form-card" asp-controller="Trade" asp-action="SellOrder" method="post">
			<input type="hidden" name="StockName" value="@Model.StockName" />
			<input type="hidden" name="StockSymbol" value="@Model.StockSymbol" />
			<input type="hidden" name="Price" value="@Model.Price" />

			<input type="number" name="Quantity" value="@Model.Quantity" />

			<button type="submit" class=" btn btn-danger">Sell</button>
		</form>
		
		
	</div>
</div>






<script>
	var stockSymbol = document.getElementById("stockSymbol").value;
	var token = "@Configuration["Finnhub:Token"]";
	var socket = new WebSocket("wss://ws.finnhub.io?token=" + token);

	//subscribe
	socket.onopen=function(){
	socket.send(JSON.stringify({type: "subscribe", symbol: stockSymbol}));
	};

	//on message 
		socket.onmessage = function(event){
		var response = JSON.parse(event.data);
		if(response.data && response.data.length > 0){
			var latestPrice = response.data[0].p;
			document.getElementById("stockPrice").textContent = "$ " + latestPrice;
		}
	}

	//close subscription
		window.onbeforeunload = function(){
		socket.send(JSON.stringify({type: "unsubscribe", symbol: stockSymbol}));
		socket.close();
	};


</script>

